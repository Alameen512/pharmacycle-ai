# Backend API base URL, no trailing slash. NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_API_URL="http://localhost:5000"
# Show one-click demo logins on /login. Only useful after `npm run seed -- --yes` in the backend. Leave false in production.
NEXT_PUBLIC_SHOW_DEMO="true"
# Optional. When set, the Help page shows a working mailto link.
NEXT_PUBLIC_SUPPORT_EMAIL=""
