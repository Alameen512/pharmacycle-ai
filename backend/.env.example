# ---- Required ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmacycle?schema=public"
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# ---- Server ----
PORT=5000
NODE_ENV=development
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (no trailing slash)
CLIENT_URL="http://localhost:3000"
# Bearer secret for /cron/* endpoints (needed only if you call them from an external scheduler)
CRON_SECRET=""
# Set true to run the expiry/stock check once when the server boots
RUN_MAINTENANCE_ON_BOOT=false

# ---- Optional integrations (features report "not configured" when blank) ----
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
RESEND_API_KEY=""
EMAIL_FROM="PharmaCycle.AI <onboarding@resend.dev>"
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=""
